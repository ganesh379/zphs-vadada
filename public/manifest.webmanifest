{
  "name": "ZPHS Vadada - Zilla Parishad High School",
  "short_name": "ZPHS Vadada",
  "description": "Official portal of ZPHS Vadada, Andhra Pradesh. Search digitized historical alumni student records, academic updates, and school verification portal.",
